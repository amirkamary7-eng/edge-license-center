# ============================================================================
# EDGE LICENSE CENTER by AMIRBTC — Environment Variables Template (Phase 1)
# Never commit real secrets, tokens, or RSA private keys to Git.
# ============================================================================

# Server Runtime
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# Safety Mode Guards:
# DRY_RUN blocks live on-chain settlement and live license issuance.
# Must remain DRY_RUN until Phase 2 production cutover approval.
PAYMENT_VERIFICATION_MODE="DRY_RUN"
LICENSE_ISSUANCE_MODE="DRY_RUN"

# SQLite Database & Backup Directory (Primary Source of Truth)
SQLITE_DB_PATH="./data/edge_license_center.sqlite"
SQLITE_BACKUP_DIR="./data/backups"

# Telegram Bot & Mini App (@EDGE_LicenceBot)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="EDGE_LicenceBot"
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_BOT_SEND_ENABLED="false"
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS="300"

# Short-lived Bearer Session Signing Secret (used after single-use initData exchange)
SESSION_SECRET=""
SESSION_TTL_SECONDS="900"

# Bootstrap Super Admin Telegram ID (Numeric Telegram User ID, no default secret)
BOOTSTRAP_SUPER_ADMIN_TELEGRAM_ID=""

# Polygon PoS RPC & Confirmation Rules
POLYGON_RPC_URL="https://polygon-rpc.com"
POLYGON_MIN_CONFIRMATIONS="30"
POLYGON_RPC_TIMEOUT_MS="10000"
REQUIRE_SENDER_WALLET_IN_LIVE="true"

# RSA-2048 License Signing Keys (Store in Secret Manager — NEVER commit PEM files)
RSA_PRIVATE_KEY_PEM=""
RSA_PUBLIC_KEY_PEM=""
RSA_KEY_ID="edge-rsa-v1"

# Cloudflare Worker Gateway Shared Secret (Fail-Closed: required for /api/v1/gateway/validate)
GATEWAY_SHARED_SECRET=""

# Rate Limiting & Preview Guard
RATE_LIMIT_ENABLED="true"
# Default MUST remain false. Even if enabled in local dev, NEVER grants admin privileges.
ALLOW_PHASE0_PREVIEW_SESSION="false"

# Background Poller, Notification Dispatcher & Scheduled Backup
# Keep false until Staging/Production host is configured.
SCHEDULER_ENABLED="false"
PAYMENT_POLL_INTERVAL_MS="30000"
NOTIFICATION_POLL_INTERVAL_MS="15000"
MAINTENANCE_INTERVAL_MS="60000"
BACKUP_INTERVAL_MS="21600000"
BACKUP_RETENTION_COUNT="14"

